tg_videos` AS videos\n    ON stats.video_id = videos.video_id\n\nCROSS JOIN tracking_start AS tracking", "relation_name": "`youtube_content_intelligence`.`marts`.`fct_content_freshness_daily`", "batch_results": null, "overload_results": null}], "elapsed_time": 45.49476981163025, "args": {"log_level": "info", "require_all_warnings_handled_by_warn_error": true, "use_fast_test_edges": false, "defer": false, "sqlparse": {"MAX_GROUPING_DEPTH": null, "MAX_GROUPING_TOKENS": null}, "invocation_command": "dbt run --select fct_content_freshness_daily", "log_level_file": "debug", "snowflake_projects_otel": false, "introspect": true, "static_parser": true, "latest_version_pointer_enabled_by_default": false, "require_batched_execution_for_custom_microbatch_strategy": true, "favor_state": false, "maximum_seed_size_mib": 1, "require_unique_project_resource_names": false, "cache_selected_only": false, "log_format": "default", "state_modified_compare_more_unrendered_values": true, "require_generic_test_arguments_property": true, "require_ref_searches_node_package_before_root": false, "use_colors_file": true, "require_nested_cumulative_type_params": true, "select": ["fct_content_freshness_daily"], "require_sql_header_in_test_configs": false, "partial_parse": true, "state_modified_compare_vars": false, "source_freshness_run_project_hooks": true, "use_colors": true, "log_file_max_bytes": 10485760, "log_format_file": "debug", "quiet": false, "require_corrected_analysis_fqns": false, "printer_width": 80, "show_resource_report": false, "allow_jinja_file_extensions": false, "hints_enabled": true, "macro_debugging": false, "log_path": "C:\\Users\\HP PC\\Documents\\my_portfolio_projects\\youtube-content-intelligence-pipeline-and-analytics\\analytics_models\\logs", "profiles_dir": "C:\\Users\\HP PC\\.dbt", "use_v2_parser": false, "support_custom_ref_kwargs": false, "v2_parser": "dbt-core-experimental-parser parse", "strict_mode": false, "require_source_and_semantic_model_names_without_spaces"